  },
  {
    "hebrew": "אֱלֹהַי, נְשָׁמָה שֶׁנָּתַתָּ בִּי טְהוֹרָה הִיא.",
    "key": "line-01",
    "file": "line-01.webm",
    "mime": "audio/webm;codecs=opus"
  },
  {
    "hebrew": "אַתָּה בְרָאתָהּ, אַתָּה יְצַרְתָּהּ, אַתָּה נְפַחְתָּהּ בִּי,",
    "key": "line-02",
    "file": "line-02.webm",
    "mime": "audio/webm;codecs=opus"
  },
  {
    "hebrew": "וְאַתָּה מְשַׁמְּרָהּ בְּקִרְבִּי.",
    "key": "line-03",
    "file": "line-03.webm",
    "mime": "audio/webm;codecs=opus"
  },
  {
    "hebrew": "כָּל זְמַן שֶׁהַנְּשָׁמָה בְּקִרְבִּי, מוֹדֶה אֲנִי לְפָנֶיךָ,",
    "key": "line-04",
    "file": "line-04.webm",
    "mime": "audio/webm;codecs=opus"
  },
  {
    "hebrew": "כָּל זְמַן שֶׁהַנְּשָׁמָה בְּקִרְבִּי, מוֹדָה אֲנִי לְפָנֶיךָ,",
    "key": "line-05",
    "file": "line-05.webm",
    "mime": "audio/webm;codecs=opus"
  },
  {
    "hebrew": "יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי וְאִמּוֹתַי, רִבּוֹן כָּל הַמַּעֲשִׂים, אֲדוֹן כָּל הַנְּשָׁמוֹת.",
    "key": "line-06",
    "file": "line-06.webm",
    "mime": "audio/webm;codecs=opus"
  },
  {
    "hebrew": "בָּרוּךְ אַתָּה יְיָ, אֲשֶׁר בְּיָדוֹ נֶפֶשׁ כָּל חַי וְרוּחַ כָּל בְּשַׂר אִישׁ.",
    "key": "line-07",
    "file": "line-07.webm",
    "mime": "audio/webm;codecs=opus"
  }
]